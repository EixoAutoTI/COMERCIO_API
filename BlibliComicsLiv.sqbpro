	IDUsuario INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	CPFUsuario TEXT NOT NULL,
	NomeUsuario TEXT NOT NULL,
	SenhaUsuario TEXT NOT NULL,
	NomeInstituicao TEXT NOT NULL,
	FOREIGN KEY (IDInstituicao) REFERENCES CadastroInstituicao(ID)
);

CREATE TABLE IF NOT EXISTS CadastroInstituicao (
	IDInstituicao INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	NomeInstituicao TEXT NOT NULL,
	CidadeInstituicao TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS CadastroEditora (
	IDEditora INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	CNPJEditora TEXT NOT NULL, 
	NomeEditora TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS CadastroLivro (
	IDLivro INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	ISBNLivro INTEGER NOT NULL, 
	TituloLivro TEXT NOT NULL,
	GeneroLivro TEXT,
	NomeEditora TEXT NOT NULL,
	FOREIGN KEY (IDEditora) REFERENCES CadastroEditora(ID)
);

CREATE TABLE IF NOT EXISTS CadastroReserva (
	IDReserva INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
	TituloLivro TEXT NOT NULL, 
	NomeUsuario TEXT NOT NULL,
	NomeEditora TEXT NOT NULL,
	DataReserva DATETIME NOT NULL,
	FOREIGN KEY (IDEditora) REFERENCES CadastroEditora(ID)
	FOREIGN KEY (IDUsuario) REFERENCES CadastroEditora(ID)
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
